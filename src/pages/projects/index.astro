---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'open-source', text: 'Open Source' }
]
---

<PageLayout title='Projects' {headings}>
  <p>
    <span data-i18n='zh'>GitHub 活动动态 (@TetraAcc)：</span>
    <span data-i18n='ja'>GitHub アクティビティ (@TetraAcc)：</span>
    <span data-i18n='en'>GitHub Activities (@TetraAcc):</span>
  </p>
  <p>
    <img
      src='https://ghchart.rshah.org/659eb9/TetraAcc'
      alt='github activities'
      loading='lazy'
    />
  </p>

  <h2 id='open-source'>
    <span data-i18n='zh'>开源项目与工具 · Open Source</span>
    <span data-i18n='ja'>オープンソース＆ツール · Open Source</span>
    <span data-i18n='en'>Open Source &amp; Tools</span>
  </h2>
  <div data-i18n='zh'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            '适用于 AstrBot 的 Deadlock 战报与个人复盘插件。免 API Key 聚合官方与 StatLocker 评分，支持群友战绩播报、个人多维打法分析、对局详情补全、多玩家同局高光与本地化成就系统。',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '📊 astrbot_plugin_tavily_quota',
          description:
            '全能 API 额度与余额监控插件。一站式查询并监控 DeepSeek、硅基流动、Kimi、智谱 GLM、GitHub、Tavily、OpenRouter 与 Serper；具备高颜值暗色仪表盘看板、未配置服务自动隔离隐藏、低额度后台自动巡检预警与 LLM 自然语言工具调用。',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <div data-i18n='ja'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            'APIキー不要で利用できる、AstrBot向けDeadlock戦績レポート＆対戦分析プラグイン。公式APIとStatLocker原画スコアを統合し、マッチ速報、多角的プレイスタイル分析、対戦詳細補完、ハイライト抽出、ローカライズ実績システムを提供。',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '📊 astrbot_plugin_tavily_quota',
          description:
            '包括的なAPIクォータ＆残高監視プラグイン。DeepSeek、SiliconFlow（珪基流動）、Moonshot（Kimi）、Zhipu（GLM）、GitHub、Tavily、OpenRouter、Serperを一元照会可能。洗練されたダークテーマダッシュボード画像生成、未設定サービスの自動非表示、残高低下時の自動巡回アラート、LLMツール呼び出しに対応。',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <div data-i18n='en'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            'Keyless Deadlock match reporting & gameplay review plugin for AstrBot. Integrates official APIs and StatLocker ratings, featuring group broadcasts, multidimensional playstyle analysis, multiplayer highlights, and localized achievements.',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '📊 astrbot_plugin_tavily_quota',
          description:
            'All-in-one API quota & balance monitor for AstrBot. Supports DeepSeek, SiliconFlow, Moonshot (Kimi), Zhipu (GLM), GitHub, Tavily, OpenRouter, and Serper. Features sleek dark-mode dashboard cards, auto-isolation of unconfigured providers, background low-balance alerts, and LLM function calling.',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>
</PageLayout>
