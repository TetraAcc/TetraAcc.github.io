---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import projectsData from '@/content/projects.json'

const headings = [
  { depth: 2, slug: 'open-source', text: 'Open Source' }
]

const projectsZh = projectsData.projects.map((p) => ({
  ...p,
  description: typeof p.description === 'object' ? (p.description.zh || '') : (p.description || '')
}))

const projectsJa = projectsData.projects.map((p) => ({
  ...p,
  description: typeof p.description === 'object' ? (p.description.ja || p.description.zh || '') : (p.description || '')
}))

const projectsEn = projectsData.projects.map((p) => ({
  ...p,
  description: typeof p.description === 'object' ? (p.description.en || p.description.zh || '') : (p.description || '')
}))
---

<PageLayout title='Projects' {headings}>
  <p>
    <span data-i18n='zh'>GitHub 活动动态 (@TetraAcc)：</span>
    <span data-i18n='ja'>GitHub アクティビティ (@TetraAcc)：</span>
    <span data-i18n='en'>GitHub Activities (@TetraAcc):</span>
  </p>
  <p>
    <img
      src='https://ghchart.rshah.org/659eb9/TetraAcc'
      alt='github activities'
      loading='lazy'
    />
  </p>

  <h2 id='open-source'>
    <span data-i18n='zh'>开源项目与工具 · Open Source</span>
    <span data-i18n='ja'>オープンソース＆ツール · Open Source</span>
    <span data-i18n='en'>Open Source &amp; Tools</span>
  </h2>
  <div data-i18n='zh'>
    <ProjectSection projects={projectsZh} />
  </div>

  <div data-i18n='ja'>
    <ProjectSection projects={projectsJa} />
  </div>

  <div data-i18n='en'>
    <ProjectSection projects={projectsEn} />
  </div>
</PageLayout>
