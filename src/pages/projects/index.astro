---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import SpotifyCrate from '@/components/music/SpotifyCrate.astro'
import SpotifyNowPlaying from '@/components/music/SpotifyNowPlaying.astro'

const headings = [
  { depth: 2, slug: 'open-source', text: 'Open Source' },
  { depth: 2, slug: 'music-crate', text: 'Music Crate' }
]
---

<PageLayout title='Projects & Crate' {headings}>
  <p>GitHub Activities (@TetraAcc):</p>
  <p>
    <img
      src='https://ghchart.rshah.org/659eb9/TetraAcc'
      alt='github activities'
      loading='lazy'
    />
  </p>

  <h2 id='open-source'>Open Source</h2>
  <div data-i18n='zh'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            '适用于 AstrBot 的 Deadlock 群友战报、打法分析、详情补全、个人六维建议与本地化成就插件（免 API Key）',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '🔍 astrbot_plugin_tavily_quota',
          description:
            '适用于 AstrBot 的 Tavily 搜索引擎与 OpenRouter API 额度/余额查询插件（自动读取凭证免配置）',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <div data-i18n='ja'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            'APIキー不要で利用できる、AstrBot向けDeadlock戦績レポート・プレイスタイル分析・ローカライズ実績プラグイン',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '🔍 astrbot_plugin_tavily_quota',
          description:
            '設定不要で認証情報を自動検出し、Tavily検索エンジンとOpenRouter APIの残高・クォータを照会するプラグイン',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <div data-i18n='en'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            'Keyless Deadlock match report, playstyle radar analysis, and localized achievement plugin for AstrBot.',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '🔍 astrbot_plugin_tavily_quota',
          description:
            'Zero-config plugin for querying Tavily Search & OpenRouter API quota and balance with automatic credential discovery.',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <h2 id='music-crate'>Music Crate</h2>
  <div class='my-3'>
    <SpotifyNowPlaying />
  </div>
  <p data-i18n='zh'>
    平时写代码、看书或散步时常听的曲目与歌单：
  </p>
  <p data-i18n='ja'>
    コーディングや読書、散歩中によく聴いているお気に入りのプレイリスト：
  </p>
  <p data-i18n='en'>
    Tracks and playlists on rotation while coding, reading, or walking:
  </p>

  <SpotifyCrate />
</PageLayout>
