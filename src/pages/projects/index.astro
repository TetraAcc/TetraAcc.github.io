---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import SpotifyCrate from '@/components/music/SpotifyCrate.astro'
import SpotifyNowPlaying from '@/components/music/SpotifyNowPlaying.astro'

const headings = [
  { depth: 2, slug: 'open-source', text: 'Open Source' },
  { depth: 2, slug: 'music-crate', text: 'Music Crate' },
  { depth: 2, slug: 'subdomains', text: 'Subdomain Gateways' }
]
---

<PageLayout title='Projects & Crate' {headings}>
  <p>GitHub Activities (@TetraAcc):</p>
  <p>
    <img
      src='https://ghchart.rshah.org/659eb9/TetraAcc'
      alt='github activities'
      loading='lazy'
    />
  </p>

  <h2 id='open-source'>Open Source</h2>
  <div data-i18n='zh'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            '适用于 AstrBot 的 Deadlock 群友战报、打法分析、详情补全、个人六维建议与本地化成就插件（免 API Key）',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '🔍 astrbot_plugin_tavily_quota',
          description:
            '适用于 AstrBot 的 Tavily 搜索引擎与 OpenRouter API 额度/余额查询插件（自动读取凭证免配置）',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <div data-i18n='ja'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            'APIキー不要で利用できる、AstrBot向けDeadlock戦績レポート・プレイスタイル分析・ローカライズ実績プラグイン',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '🔍 astrbot_plugin_tavily_quota',
          description:
            '設定不要で認証情報を自動検出し、Tavily検索エンジンとOpenRouter APIの残高・クォータを照会するプラグイン',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <div data-i18n='en'>
    <ProjectSection
      projects={[
        {
          name: '🎯 astrbot_plugin_deadbot',
          description:
            'Keyless Deadlock match report, playstyle radar analysis, and localized achievement plugin for AstrBot.',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_deadbot' }
          ]
        },
        {
          name: '🔍 astrbot_plugin_tavily_quota',
          description:
            'Zero-config plugin for querying Tavily Search & OpenRouter API quota and balance with automatic credential discovery.',
          links: [
            { type: 'github', href: 'https://github.com/TetraAcc/astrbot_plugin_tavily_quota' }
          ]
        }
      ]}
    />
  </div>

  <h2 id='music-crate'>Music Crate</h2>
  <div class='my-3'>
    <SpotifyNowPlaying />
  </div>
  <p data-i18n='zh'>
    平时写代码、看书或散步时常听的曲目与歌单（直接在 <code>src/data/music.ts</code> 里粘贴任意 Spotify 分享链接即可）：
  </p>
  <p data-i18n='ja'>
    コーディングや読書、散歩中によく聴いているお気に入りの楽曲・プレイリスト（<code>src/data/music.ts</code> にSpotify共有リンクを貼り付け可能）：
  </p>
  <p data-i18n='en'>
    Tracks and playlists on rotation while coding, reading, or walking (paste any Spotify share URL into <code>src/data/music.ts</code>):
  </p>

  <SpotifyCrate />

  <h2 id='subdomains'>Subdomain Gateways (*.tetraacc.me)</h2>
  <div data-i18n='zh'>
    <p>
      主域名 <code>tetraacc.me</code> 托管静态主页，子域名通过 Cloudflare Tunnel 指向个人设备（受 Zero Trust 访问保护）：
    </p>
    <ul>
      <li><code>ssh.tetraacc.me</code> — Windows 11 主力机远程终端隧道</li>
      <li><code>deck.tetraacc.me</code> — Steam Deck 常驻服务节点（AstrBot 与挂载资源库）</li>
    </ul>
  </div>

  <div data-i18n='ja'>
    <p>
      メインドメイン <code>tetraacc.me</code> は静的サイトをホスティングし、サブドメインは Cloudflare Tunnel 経由で自宅ノードへルーティングしています（Zero Trust 認証保護）：
    </p>
    <ul>
      <li><code>ssh.tetraacc.me</code> — Windows 11 メインマシン リモートSSHトンネル</li>
      <li><code>deck.tetraacc.me</code> — Steam Deck 常駐サーバーノード（AstrBot・ストレージ）</li>
    </ul>
  </div>

  <div data-i18n='en'>
    <p>
      Root domain <code>tetraacc.me</code> hosts this static site, while subdomains route to self-hosted nodes via Cloudflare Tunnel (protected by Zero Trust):
    </p>
    <ul>
      <li><code>ssh.tetraacc.me</code> — Windows 11 workstation remote SSH tunnel</li>
      <li><code>deck.tetraacc.me</code> — Steam Deck always-on node (AstrBot &amp; media library)</li>
    </ul>
  </div>
</PageLayout>
