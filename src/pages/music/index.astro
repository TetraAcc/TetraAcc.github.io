---
import PageLayout from '@/layouts/CommonPage.astro'
import SpotifyCrate from '@/components/music/SpotifyCrate.astro'
import SpotifyNowPlaying from '@/components/music/SpotifyNowPlaying.astro'

const headings = [
  { depth: 2, slug: 'now-playing', text: 'Now Playing' },
  { depth: 2, slug: 'spotify-playlist', text: 'Spotify' },
  { depth: 2, slug: 'netease-music', text: 'NetEase Music' },
  { depth: 2, slug: 'bilibili-radio', text: 'Bilibili Radio' }
]
---

<PageLayout title='Music & Radio' {headings}>
  <p data-i18n='zh'>
    这里是我的私人视听角落。存放不同季节常听的歌单、电台投稿，以及当前的实时听歌状态。
  </p>
  <p data-i18n='ja'>
    プライベートな音楽・ラジオのアーカイブスペース。季節ごとのプレイリストやラジオ投稿、現在のリアルタイム再生状況を記録しています。
  </p>
  <p data-i18n='en'>
    My personal music &amp; audio corner. A collection of playlists, radio episodes, and live listening status.
  </p>

  <h2 id='now-playing'>Now Playing · 实时收听</h2>
  <div class='my-3'>
    <SpotifyNowPlaying />
  </div>

  <h2 id='spotify-playlist'>Spotify · 专属歌单</h2>
  <SpotifyCrate />

  <h2 id='netease-music'>NetEase Music · 网易云音乐</h2>
  <div class='my-4 rounded-xl border border-dashed p-6 text-center text-sm text-muted-foreground'>
    <p data-i18n='zh'>网易云外链歌单准备接入中（发送歌单链接或 ID 后即可自动挂载）</p>
    <p data-i18n='ja'>NetEase Cloud Music プレイリスト準備中</p>
    <p data-i18n='en'>NetEase Cloud Music playlist coming soon.</p>
  </div>

  <h2 id='bilibili-radio'>Bilibili Radio · 个人电台精选</h2>
  <div class='my-4 rounded-xl border border-dashed p-6 text-center text-sm text-muted-foreground'>
    <p data-i18n='zh'>B 站电台播客卡片准备接入中（发送几期视频/音频链接后即可自动挂载）</p>
    <p data-i18n='ja'>Bilibili ラジオ・ポッドキャスト準備中</p>
    <p data-i18n='en'>Bilibili radio episodes coming soon.</p>
  </div>
</PageLayout>
