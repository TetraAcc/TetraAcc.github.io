---
import { Image } from 'astro:assets'

import PostPreview from '@/components/blog/PostPreview.astro'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import SpotifyNowPlaying from '@/components/music/SpotifyNowPlaying.astro'
import config from '@/site-config'
import nowData from '@/content/now.json'
import projectsData from '@/content/projects.json'
import skillsData from '@/content/skills.json'

type NowItem = { icon?: string; label: string; content: string }
const nowItems: NowItem[] = ((nowData as any).items as NowItem[])?.length
  ? ((nowData as any).items as NowItem[])
  : [
      (nowData as any).reading && { icon: '📖', label: '正在阅读', content: (nowData as any).reading },
      (nowData as any).listening && { icon: '🎧', label: '正在收听', content: (nowData as any).listening },
      (nowData as any).working && { icon: '💻', label: '正在进行', content: (nowData as any).working }
    ].filter(Boolean) as NowItem[]

const languages = skillsData.languages || ['Python', 'TypeScript', 'C / C++', 'SQL', 'Shell']
const toolsAndFrameworks = skillsData.tools || ['Git', 'Linux', 'Astro', 'Node.js', 'Docker']
const environment = skillsData.environment || ['Windows 11', 'SteamOS / Arch', 'Cloudflare Tunnel']

const featuredProjects = projectsData.projects.slice(0, 2)

const MAX_POSTS = 3
const allPosts = await getBlogCollection()
const pinnedPosts = sortMDByDate(allPosts.filter((p) => p.data.pin))
const recentPosts = sortMDByDate(allPosts.filter((p) => !p.data.pin)).slice(0, MAX_POSTS)
const allPostsByDate = [...pinnedPosts, ...recentPosts]

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Profile'}
        class='size-28 rounded-full border p-1 object-cover'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>
          <span data-i18n='zh'>侯润田 · Runtian Hou</span>
          <span data-i18n='ja'>侯潤田 · Runtian Hou</span>
          <span data-i18n='en'>Runtian Hou (Tetra)</span>
        </h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='日本 · 山形' data-i18n='zh'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='山形県米沢市' data-i18n='ja'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='Yamagata, Japan' data-i18n='en'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Email'
            as='a'
            href='mailto:Tetrahrt@gmail.com'
          >
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
          <Label
            title='GitHub'
            as='a'
            href='https://github.com/TetraAcc'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Bilibili'
            as='a'
            href='https://space.bilibili.com/15413289'
            target='_blank'
          >
            <Icon name='bilibili' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Steam'
            as='a'
            href='https://steamcommunity.com/id/TetraAcc/'
            target='_blank'
          >
            <Icon name='steam' class='size-5' slot='icon' />
          </Label>
        </div>
        <SpotifyNowPlaying class='mt-1' variant='home' />
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground' data-i18n='zh'>软件工程 · 情报科学 / Software Engineering</p>
        <p class='text-muted-foreground' data-i18n='ja'>ソフトウェアエンジニアリング · 情報科学</p>
        <p class='text-muted-foreground' data-i18n='en'>Software Engineering &amp; Computer Science</p>

        <p class='text-muted-foreground' data-i18n='zh'>
          来自安徽合肥。现居山形米泽。就读于山形大学。请多指教。
        </p>
        <p class='text-muted-foreground' data-i18n='ja'>
          中国・安徽省合肥市出身。山形県米沢市在住、山形大学在学中。よろしくお願いします。
        </p>
        <p class='text-muted-foreground' data-i18n='en'>
          From Hefei, Anhui. Currently based in Yonezawa, Yamagata, studying at Yamagata University. Have a good one!
        </p>

        <div data-i18n='zh' class='flex justify-end'>
          <Button title='更多关于我' class='w-fit' href='/about' variant='ahead' />
        </div>
        <div data-i18n='ja' class='flex justify-end'>
          <Button title='詳しい自己紹介' class='w-fit' href='/about' variant='ahead' />
        </div>
        <div data-i18n='en' class='flex justify-end'>
          <Button title='More about me' class='w-fit' href='/about' variant='ahead' />
        </div>
      </Section>

      {/* Now */}
      <Section title='Now'>
        <div class='flex flex-col gap-y-3.5 rounded-xl border p-4 sm:p-5 text-sm sm:text-base'>
          <div class='flex flex-wrap items-center justify-between gap-2 border-b pb-3 text-xs text-muted-foreground'>
            <div class='flex items-center gap-x-2'>
              <span class='relative flex size-2'>
                <span class='absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75'></span>
                <span class='relative inline-flex size-2 rounded-full bg-emerald-500'></span>
              </span>
              <span class='font-medium text-foreground'>{nowData.status}</span>
            </div>
            {
              nowData.updated && (
                <span>
                  <span data-i18n='zh'>最近更新 · {nowData.updated}</span>
                  <span data-i18n='ja'>最終更新 · {nowData.updated}</span>
                  <span data-i18n='en'>Updated · {nowData.updated}</span>
                </span>
              )
            }
          </div>

          <div class='flex flex-col gap-y-3 pt-0.5'>
            {
              nowItems.map((item) => (
                <div class='flex items-start gap-x-2.5 text-sm sm:text-base leading-relaxed'>
                  <span class='inline-flex items-center shrink-0 font-medium text-muted-foreground'>
                    {item.icon && <span class='me-1.5'>{item.icon}</span>}
                    <span>{item.label}：</span>
                  </span>
                  <span class='text-foreground/90 break-words'>
                    {item.content}
                  </span>
                </div>
              ))
            }
          </div>

          {
            nowData.note && (
              <div class='mt-1 rounded-lg bg-muted/40 border-l-2 border-primary/50 px-3.5 py-2.5 text-sm text-muted-foreground italic leading-relaxed'>
                “{nowData.note}”
              </div>
            )
          }
        </div>
      </Section>

      {
        allPostsByDate.length > 0 && (
          <Section title='Writing'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <div data-i18n='zh' class='flex justify-end'>
              <Button title='所有文章' class='w-fit' href='/blog' variant='ahead' />
            </div>
            <div data-i18n='ja' class='flex justify-end'>
              <Button title='すべての記事' class='w-fit' href='/blog' variant='ahead' />
            </div>
            <div data-i18n='en' class='flex justify-end'>
              <Button title='All posts' class='w-fit' href='/blog' variant='ahead' />
            </div>
          </Section>
        )
      }

      <Section title='Open Source'>
        <div class='flex flex-col gap-y-3' data-i18n='zh'>
          {
            featuredProjects.map((p) => {
              const href = p.links?.find((l) => l.type === 'github')?.href || p.links?.[0]?.href || '#'
              const sub = typeof p.description === 'object' ? (p.description.zh || '') : (p.description || '')
              return (
                <Card
                  as='a'
                  heading={p.name.replace(/^[^\w\s\u4e00-\u9fa5]+/, '').trim() || p.name}
                  subheading={sub}
                  date='Python · GitHub'
                  href={href}
                  target='_blank'
                />
              )
            })
          }
        </div>

        <div class='flex flex-col gap-y-3' data-i18n='ja'>
          {
            featuredProjects.map((p) => {
              const href = p.links?.find((l) => l.type === 'github')?.href || p.links?.[0]?.href || '#'
              const sub = typeof p.description === 'object' ? (p.description.ja || p.description.zh || '') : (p.description || '')
              return (
                <Card
                  as='a'
                  heading={p.name.replace(/^[^\w\s\u4e00-\u9fa5]+/, '').trim() || p.name}
                  subheading={sub}
                  date='Python · GitHub'
                  href={href}
                  target='_blank'
                />
              )
            })
          }
        </div>

        <div class='flex flex-col gap-y-3' data-i18n='en'>
          {
            featuredProjects.map((p) => {
              const href = p.links?.find((l) => l.type === 'github')?.href || p.links?.[0]?.href || '#'
              const sub = typeof p.description === 'object' ? (p.description.en || p.description.zh || '') : (p.description || '')
              return (
                <Card
                  as='a'
                  heading={p.name.replace(/^[^\w\s\u4e00-\u9fa5]+/, '').trim() || p.name}
                  subheading={sub}
                  date='Python · GitHub'
                  href={href}
                  target='_blank'
                />
              )
            })
          }
        </div>

        <div data-i18n='zh' class='flex justify-end'>
          <Button title='更多项目' class='w-fit' href='/projects' variant='ahead' />
        </div>
        <div data-i18n='ja' class='flex justify-end'>
          <Button title='他のプロジェクト' class='w-fit' href='/projects' variant='ahead' />
        </div>
        <div data-i18n='en' class='flex justify-end'>
          <Button title='More projects' class='w-fit' href='/projects' variant='ahead' />
        </div>
      </Section>

      <Section title='Education'>
        <div data-i18n='zh'>
          <Card
            heading='山形大学 (Yamagata University)'
            subheading='工学部 · 情報エレクトロニクス学科 (信息与电子工程)'
            date='Yonezawa, Yamagata, Japan'
          />
        </div>
        <div data-i18n='ja'>
          <Card
            heading='山形大学 (Yamagata University)'
            subheading='工学部 · 情報エレクトロニクス学科'
            date='山形県米沢市'
          />
        </div>
        <div data-i18n='en'>
          <Card
            heading='Yamagata University'
            subheading='Faculty of Engineering · Department of Informatics and Electronics'
            date='Yonezawa, Yamagata, Japan'
          />
        </div>
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Tools' skills={toolsAndFrameworks} />
        <SkillLayout title='Environment' skills={environment} />
      </Section>
    </div>
  </main>
</PageLayout>
