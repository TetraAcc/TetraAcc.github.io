---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(collections).map(([tag]) => tag)
  const collectionsCount = collections.length
  const essayUrls = collections
    .filter((post) => post.id.startsWith('essays/') || post.data.tags.includes('随笔'))
    .map((post) => `/blog/${post.id}`)
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, collectionsCount, essayUrls }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
  essayUrls: string[]
}

const { page, uniqueTags, collectionsCount, essayUrls } = Astro.props

const meta = {
  description: 'Some posts or archives of my blog',
  title: 'Blog'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Posts`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Posts →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-2 mt-6 text-3xl font-medium sm:mt-10'>Blog</h1>
      <p class='text-sm text-muted-foreground mb-5'>
        <span data-i18n='zh'>手稿企划、散文随笔与按年份编排的生活日记。</span>
        <span data-i18n='ja'>手稿アーカイブ、エッセイ随筆、年代順の日記記録。</span>
        <span data-i18n='en'>Handwritten archives, essays, and chronological journals.</span>
      </p>

      {/* 快速分类导航 pills */}
      <div class='mb-6 flex flex-wrap items-center gap-2 text-xs'>
        <a
          href='/blog'
          class='rounded-full border border-foreground/30 bg-muted px-3 py-1 font-medium text-foreground no-underline transition-colors'
        >
          <span data-i18n='zh'>全部</span>
          <span data-i18n='ja'>すべて</span>
          <span data-i18n='en'>All</span>
        </a>
        <a
          href='/tags/手稿'
          class='rounded-full border border-border/70 px-3 py-1 text-muted-foreground hover:border-foreground/30 hover:text-foreground no-underline transition-colors'
        >
          📚 <span data-i18n='zh'>手稿</span><span data-i18n='ja'>手稿</span><span data-i18n='en'>Manuscripts</span>
        </a>
        <a
          href='/tags/文集'
          class='rounded-full border border-border/70 px-3 py-1 text-muted-foreground hover:border-foreground/30 hover:text-foreground no-underline transition-colors'
        >
          📖 <span data-i18n='zh'>文集</span><span data-i18n='ja'>文集</span><span data-i18n='en'>Anthology</span>
        </a>
        <a
          href='/tags/随笔'
          class='rounded-full border border-border/70 px-3 py-1 text-muted-foreground hover:border-foreground/30 hover:text-foreground no-underline transition-colors'
        >
          📝 <span data-i18n='zh'>随笔</span><span data-i18n='ja'>随筆</span><span data-i18n='en'>Essays</span>
        </a>
        <a
          href='/tags/长文'
          class='rounded-full border border-border/70 px-3 py-1 text-muted-foreground hover:border-foreground/30 hover:text-foreground no-underline transition-colors'
        >
          📄 <span data-i18n='zh'>长文</span><span data-i18n='ja'>長文</span><span data-i18n='en'>Long</span>
        </a>
        <a
          href='/tags/短文'
          class='rounded-full border border-border/70 px-3 py-1 text-muted-foreground hover:border-foreground/30 hover:text-foreground no-underline transition-colors'
        >
          ✍️ <span data-i18n='zh'>短文</span><span data-i18n='ja'>短文</span><span data-i18n='en'>Short</span>
        </a>
        <div class='flex flex-wrap items-center gap-2 sm:ms-auto'>
          <a
            id='random-post-btn'
            href='#'
            class='group flex items-center gap-1.5 rounded-full border border-border/70 px-3 py-1 text-muted-foreground hover:border-foreground/30 hover:text-foreground no-underline transition-colors cursor-pointer'
            data-essay-urls={JSON.stringify(essayUrls)}
            title='随机阅读一篇公开随笔'
          >
            <span class='inline-block transition-transform duration-300 group-hover:rotate-45'>🎲</span>
            <span data-i18n='zh'>随机读一篇</span>
            <span data-i18n='ja'>ランダム随筆</span>
            <span data-i18n='en'>Random Essay</span>
          </a>
          <a
            href='/archives'
            class='rounded-full border border-border/70 px-3 py-1 text-muted-foreground hover:border-foreground/30 hover:text-foreground no-underline transition-colors'
          >
            <span data-i18n='zh'>时间轴 Archives →</span>
            <span data-i18n='ja'>年表アーカイブ →</span>
            <span data-i18n='en'>Timeline →</span>
          </a>
        </div>
      </div>
    </div>
    {
      page.data.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section aria-label='Blog posts list' class='animate' id='content'>
            {/* header */}
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                <span data-i18n='zh'>第 {page.currentPage} 页 · 共 {collectionsCount} 篇</span>
                <span data-i18n='ja'>ページ {page.currentPage} · 全 {collectionsCount} 件</span>
                <span data-i18n='en'>Page {page.currentPage} · Showing {page.data.length} of {collectionsCount} posts</span>
              </span>
              <a aria-label='View all blog by years' href='/archives' data-astro-prefetch>
                <span data-i18n='zh'>按年份查看全部 →</span>
                <span data-i18n='ja'>年代順にすべて見る →</span>
                <span data-i18n='en'>View all posts by years →</span>
              </a>
            </div>
            {/* posts */}
            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
            <Paginator {...paginationProps} />
          </section>

          {/* sidebar */}
          {!!uniqueTags.length && (
            <aside class='animate' id='sidebar'>
              <h2 class='mb-4 flex items-center text-lg font-medium'>
                <Icon name='tag-2' class='me-2' />
                <span data-i18n='zh'>标签</span>
                <span data-i18n='ja'>タグ</span>
                <span data-i18n='en'>Tags</span>
              </h2>
              <ul class='text-bgColor flex flex-wrap gap-2'>
                {
                  // Only show top 50 tags in sidebar
                  uniqueTags.slice(0, 50).map((tag) => (
                    <li>
                      <Button title={tag} href={`/tags/${tag}`} variant='pill' />
                    </li>
                  ))
                }
              </ul>
              <span class='mt-4 block sm:text-end'>
                <a aria-label='View all blog categories' href='/tags' data-astro-prefetch>
                  <span data-i18n='zh'>查看全部 →</span>
                  <span data-i18n='ja'>すべて見る →</span>
                  <span data-i18n='en'>View all →</span>
                </a>
              </span>
            </aside>
          )}
        </div>
      )
    }
  </main>

  <script>
    function setupRandomPostButton() {
      const btn = document.getElementById('random-post-btn') as HTMLAnchorElement | null
      if (!btn) return

      let urls: string[] = []
      try {
        urls = JSON.parse(btn.dataset.essayUrls || '[]')
      } catch {
        urls = []
      }
      if (!urls.length) return

      const pickRandomUrl = () => {
        const currentPath = window.location.pathname.replace(/\/$/, '')
        const available = urls.filter((u) => u.replace(/\/$/, '') !== currentPath)
        const candidates = available.length > 0 ? available : urls
        const idx = Math.floor(Math.random() * candidates.length)
        return candidates[idx]
      }

      // Pre-set a random link so right-click / middle-click works natively
      btn.href = pickRandomUrl()

      // Refresh target when hovering
      btn.onpointerenter = () => {
        btn.href = pickRandomUrl()
      }

      // On click, immediately navigate to a freshly picked random essay
      btn.onclick = (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey) {
          setTimeout(() => {
            btn.href = pickRandomUrl()
          }, 100)
          return
        }
        e.preventDefault()
        const target = pickRandomUrl()
        btn.href = target
        window.location.href = target
      }
    }

    setupRandomPostButton()
    document.addEventListener('astro:page-load', setupRandomPostButton)
  </script>
</PageLayout>
