---
import { Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import GearSection from '@/components/about/GearSection.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'tools', text: 'Tools & Environment' },
  { depth: 2, slug: 'gear', text: 'Gear & Setup' },
  { depth: 2, slug: 'about-site', text: 'About Site' },
  { depth: 2, slug: 'guestbook', text: 'Guestbook' }
]
---

<PageLayout title='About' {headings} comment={true}>
  <h2 id='about-me'>
    <span data-i18n='zh'>关于我 · About Me</span>
    <span data-i18n='ja'>自己紹介 · Profile</span>
    <span data-i18n='en'>About Me</span>
  </h2>
  <div data-i18n='zh'>
    <p>
      我是侯润田（Tetra），目前常驻日本山形县米泽市，就读于山形大学工学部信息与电子工程专业。
    </p>
    <p>
      建这个站点的初衷很简单：把平时写在纸上或文档里的随笔收拢到一个干净的地方，顺便记录一些写过的小工具、代码切片和喜欢的音乐。
    </p>
  </div>

  <div data-i18n='ja'>
    <p>
      侯 潤田（コウ ジュンデン / Runtian Hou）と申します。現在、山形県米沢市に在住し、山形大学工学部 情報エレクトロニクス学科にてソフトウェアエンジニアリング分野を専攻しています。
    </p>
    <p>
      日々の思考を綴った随筆や、個人開発したソフトウェア・スクリプト、お気に入りの音楽をシンプルな形でアーカイブするためにこのサイトを立ち上げました。
    </p>
  </div>

  <div data-i18n='en'>
    <p>
      I am Runtian Hou (Tetra), currently based in Yonezawa, Yamagata, Japan, studying at Yamagata University Faculty of Engineering, Department of Informatics and Electronics, with a focus on software engineering.
    </p>
    <p>
      I built this site as a clean, distraction-free home for my personal essays, open-source tools, code snippets, and music recommendations.
    </p>
  </div>

  <h2 id='tools'>
    <span data-i18n='zh'>开发环境与工具 · Environment</span>
    <span data-i18n='ja'>開発環境＆ツール</span>
    <span data-i18n='en'>Tools &amp; Environment</span>
  </h2>
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'Primary Editor',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Git / GitHub',
        description: 'Version Control',
        href: 'https://github.com/TetraAcc',
        icon: import('@/assets/tools/neovim.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Windows 11',
        description: 'Main Workstation',
        href: 'https://www.microsoft.com/windows/',
        icon: import('@/assets/tools/windows11.svg?raw')
      },
      {
        name: 'SteamOS / Linux',
        description: 'Home Server & AstrBot Node',
        href: 'https://archlinux.org/',
        icon: import('@/assets/tools/archlinux.svg?raw')
      }
    ]}
  />

  <h2 id='gear'>
    <span data-i18n='zh'>装备与环境 · Gear &amp; Setup</span>
    <span data-i18n='ja'>装備＆デスク環境 · Gear</span>
    <span data-i18n='en'>Gear &amp; Desk Setup</span>
  </h2>

  <GearSection
    title='Computing & Display · 计算与显示'
    items={[
      {
        name: '雷神 猎刃 16 (ThundeRobot)',
        spec: 'Intel i7-14650HX · RTX 4060M · 16G / 1T',
        desc: '主力开发与游戏笔记本，承担日常代码编译、深度学习轻量任务与图形渲染。',
        icon: '💻',
        tag: 'Laptop'
      },
      {
        name: 'Steam Deck (LCD)',
        spec: '改装 1TB NVMe SSD · SteamOS / Arch Linux',
        desc: '随身掌机与便携 Linux 节点，日常游戏串流与 AstrBot 插件调试机。',
        icon: '🎮',
        tag: 'Handheld'
      },
      {
        name: 'Zedge U27P 4K',
        spec: '27 英寸 · 3840×2160 UHD 超清',
        desc: '主力 4K 显示器，细腻字体呈现，多窗口代码分屏与影音创作核心。',
        icon: '🖥️',
        tag: 'Monitor'
      }
    ]}
  />

  <GearSection
    title='Peripherals & Gaming · 外设与交互'
    items={[
      {
        name: '珂芝 Kzzi K75 Pro',
        spec: '75% 紧凑配列 · Gasket 结构 · 三模热插拔',
        desc: '主力客制化机械键盘，手感柔韧温润，日常文字输出与打字主力。',
        icon: '⌨️',
        tag: 'Keyboard'
      },
      {
        name: '赛睿 SteelSeries Prime Wireless',
        spec: 'Prestige OM™ 光磁微动 · 轻量无线',
        desc: '主力无线电竞鼠标，定位利落精准，长时间握持不易疲劳。',
        icon: '🖱️',
        tag: 'Mouse'
      },
      {
        name: 'Nintendo Switch Pro 手柄',
        spec: '经典人体工学握持 · 蓝牙无线连接',
        desc: 'PC 与 Steam Deck 游戏主力控制器，震动细腻，动作游戏必备。',
        icon: '🕹️',
        tag: 'Gamepad'
      }
    ]}
  />

  <GearSection
    title='Audio & Hi-Fi · 音频与实体音乐'
    items={[
      {
        name: '铁三角 Audio-Technica AT-LP60X',
        spec: '全自动皮带驱动立体声黑胶唱盘机',
        desc: '黑胶唱片主力播放设备，搭配模拟专辑收藏，品味纯粹的实体听音质感。',
        icon: '📻',
        tag: 'Turntable'
      },
      {
        name: '东芝 TOSHIBA TY-C250',
        spec: '便携式 CD 音响系统',
        desc: '实体 CD 唱片播放主力，承载日版专辑与单曲实体回放。',
        icon: '💿',
        tag: 'CD Player'
      },
      {
        name: '铁三角 Audio-Technica AT-SP95',
        spec: '桌面立体声有源音箱',
        desc: '紧凑桌面回放终端，人声温暖自然，日常音乐与播客背景音主力。',
        icon: '🔊',
        tag: 'Speaker'
      },
      {
        name: '索尼 Sony WH-1000XM3',
        spec: '头戴式无线降噪耳机 · LDAC 高解析',
        desc: '主力沉浸听音与降噪耳机，实验室与深冬专注写码必备。',
        icon: '🎧',
        tag: 'Headphone'
      },
      {
        name: 'Amazon Echo Buds 2',
        spec: '真无线入耳式 · 主动降噪 (ANC)',
        desc: '随身出行与通勤主力 TWS，语音联动 Alexa 便捷交互。',
        icon: '🎵',
        tag: 'TWS'
      },
      {
        name: '西圣 Xisem Olite',
        spec: '开放式不入耳蓝牙耳机 · 气传导',
        desc: '长时间挂耳佩戴舒适无感，运动与室外散步时保障环境声安全。',
        icon: '🏃',
        tag: 'Open-Ear'
      }
    ]}
  />

  <GearSection
    title='Mobile & Smart Home · 移动设备与智能家居'
    items={[
      {
        name: 'Amazon Echo Show 5 (Gen 2)',
        spec: '刷机 Android 固件 · 5.5 英寸触控屏',
        desc: '改造为桌面极客副屏与监控看板，实时显示时间、天气与状态。',
        icon: '📟',
        tag: 'Smart Display'
      },
      {
        name: 'Amazon Echo Dot 4',
        spec: '球形智能音箱 · Alexa 语音中枢',
        desc: '智能家居控制总节点，语音控制开关、闹钟与居家自动化联动。',
        icon: '🎙️',
        tag: 'Smart Home'
      },
      {
        name: 'Realme GT8',
        spec: '16GB RAM + 512GB ROM 旗舰配置',
        desc: '日常主力手机，性能充沛，承担通信、拍照记录与高负载应用。',
        icon: '📱',
        tag: 'Phone'
      },
      {
        name: 'Apple iPhone SE 3',
        spec: 'Apple A15 Bionic 仿生芯片',
        desc: '备用机与 iOS 跨平台测试终端，小巧轻便的手感体验。',
        icon: '🍎',
        tag: 'Phone'
      },
      {
        name: '联想小新 Pad Pro 12.7',
        spec: '12.7 英寸 144Hz 巨幕大屏',
        desc: '大屏学习平板，文献研读、分屏备课与移动影音主力设备。',
        icon: '📋',
        tag: 'Tablet'
      },
      {
        name: '哈趣 H3 (Haqu H3)',
        spec: '便携全高清家用投影仪',
        desc: '卧室巨幕观影体验，周末沉浸式投影看电影与纪录片。',
        icon: '📽️',
        tag: 'Projector'
      }
    ]}
  />

  <h2 id='about-site'>
    <span data-i18n='zh'>关于本站 · About Site</span>
    <span data-i18n='ja'>このサイトについて</span>
    <span data-i18n='en'>About Site</span>
  </h2>
  <div data-i18n='zh'>
    <Timeline
      events={[
        {
          date: '2026-11-07',
          content:
            '使用 <a href="https://astro.build/" target="_blank">Astro</a> 与 <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a> 搭建个人主页，绑定域名 <code>tetraacc.me</code>。'
        }
      ]}
    />
  </div>
  <div data-i18n='ja'>
    <Timeline
      events={[
        {
          date: '2026-11-07',
          content:
            '<a href="https://astro.build/" target="_blank">Astro</a> と <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a> を用いて個人ホームページを構築、独自ドメイン <code>tetraacc.me</code> を設定。'
        }
      ]}
    />
  </div>
  <div data-i18n='en'>
    <Timeline
      events={[
        {
          date: '2026-11-07',
          content:
            'Launched personal website with <a href="https://astro.build/" target="_blank">Astro</a> &amp; <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a>, deployed to <code>tetraacc.me</code>.'
        }
      ]}
    />
  </div>

  <h2 id='guestbook'>
    <span data-i18n='zh'>留言板 · Guestbook</span>
    <span data-i18n='ja'>ゲストブック · 交流</span>
    <span data-i18n='en'>Guestbook</span>
  </h2>
  <div data-i18n='zh'>
    <p class='text-muted-foreground'>
      无论是关于随笔文章、长篇手稿、音乐还是代码工具，欢迎在此留下足迹、提问交流或打个招呼。
    </p>
  </div>
  <div data-i18n='ja'>
    <p class='text-muted-foreground'>
      随筆、手稿、音楽、またはコードやツールについて、ご感想やメッセージがあればお気軽にどうぞ。
    </p>
  </div>
  <div data-i18n='en'>
    <p class='text-muted-foreground'>
      Feel free to leave a message, say hello, or share your thoughts on essays, manuscripts, music, or code.
    </p>
  </div>
</PageLayout>
