---
import { Footer, Header, ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta & { noindex?: boolean }
  highlightColor?: string
}

const {
  meta: { articleDate, description = config.description, ogImage, title, noindex },
  highlightColor,
  ...props
} = Astro.props
---

<html lang={config.locale.lang} data-lang='zh'>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    {noindex && <meta name='robots' content='noindex, nofollow' />}
    <ThemeProvider />
    <script is:inline>
      ;(function () {
        const saved = localStorage.getItem('site-lang') || 'zh'
        document.documentElement.setAttribute('data-lang', saved)
        document.documentElement.setAttribute(
          'lang',
          saved === 'ja' ? 'ja' : saved === 'en' ? 'en' : 'zh-CN'
        )
      })()
    </script>
  </head>

  <body class='flex justify-center bg-background text-foreground' {...props}>
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 h-screen w-full opacity-25'
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    <div
      id='main-container'
      class='w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'
    >
      <Header />
      <div class='flex-1 w-full'>
        <slot />
      </div>
      <Footer />
    </div>

    <script is:inline>
      ;(function () {
        const NAV_LABELS = {
          zh: { '/blog': '博客', '/projects': '项目', '/music': '音乐', '/about': '关于' },
          ja: { '/blog': 'ブログ', '/projects': 'プロジェクト', '/music': '音楽', '/about': '自己紹介' },
          en: { '/blog': 'Blog', '/projects': 'Projects', '/music': 'Music', '/about': 'About' }
        }

        const TOC_MAP = {
          zh: {
            'now-playing': '实时收听',
            'spotify-playlist': 'Spotify 歌单',
            'netease-music': '网易云音乐',
            'radio': '双极电台',
            'cover': '翻唱演奏',
            'live': '现场记录',
            'about-me': '关于我',
            'tools': '环境与工具',
            'about-site': '关于本站',
            'open-source': '开源项目'
          },
          ja: {
            'now-playing': '再生中',
            'spotify-playlist': 'Spotify 厳選',
            'netease-music': 'NetEase 音楽',
            'radio': '双極ラジオ',
            'cover': 'カバー＆演奏',
            'live': 'ライブ記録',
            'about-me': '自己紹介',
            'tools': '開発環境＆ツール',
            'about-site': 'このサイトについて',
            'open-source': 'オープンソース'
          },
          en: {
            'now-playing': 'Now Playing',
            'spotify-playlist': 'Spotify',
            'netease-music': 'NetEase Music',
            'radio': 'Radio',
            'cover': 'Cover',
            'live': 'Live',
            'about-me': 'About Me',
            'tools': 'Tools & Environment',
            'about-site': 'About Site',
            'open-source': 'Open Source'
          }
        }

        function applyLang(lang) {
          try {
            document.documentElement.setAttribute('data-lang', lang)
            document.documentElement.setAttribute(
              'lang',
              lang === 'ja' ? 'ja' : lang === 'en' ? 'en' : 'zh-CN'
            )
            localStorage.setItem('site-lang', lang)

            // Update header brand
            const brandEl = document.querySelector('header-component a[aria-label="Brand"]')
            if (brandEl) {
              brandEl.textContent =
                lang === 'ja'
                  ? 'Tetra · 侯潤田'
                  : lang === 'en'
                    ? 'Tetra · Runtian Hou'
                    : 'Tetra · 侯润田'
            }

            // Update header nav links
            const labels = NAV_LABELS[lang] || NAV_LABELS.zh
            document.querySelectorAll('header-component a[aria-label="Nav menu item"]').forEach((a) => {
              const href = a.getAttribute('href')
              if (href && labels[href]) {
                a.textContent = labels[href]
              }
            })

            // Update TOC title
            const tocTitleEl = document.querySelector('toc-heading h2')
            if (tocTitleEl) {
              tocTitleEl.textContent =
                lang === 'ja' ? '目次' : lang === 'zh' ? '目录' : 'TABLE OF CONTENTS'
            }

            // Update TOC item anchors
            if (TOC_MAP[lang]) {
              document.querySelectorAll('toc-heading a.toc-item').forEach((a) => {
                const href = a.getAttribute('href') || ''
                const slug = href.startsWith('#') ? href.slice(1) : href
                if (slug && TOC_MAP[lang][slug]) {
                  a.textContent = TOC_MAP[lang][slug]
                }
              })
            }

            // Update active button state
            document.querySelectorAll('#langSwitcher button[data-set-lang]').forEach((btn) => {
              const isAct = btn.getAttribute('data-set-lang') === lang
              btn.classList.toggle('lang-active', isAct)
            })
          } catch (e) {
            console.error('[i18n] applyLang failed:', e)
          }
        }

        function mountLangSwitcher() {
          const btnGroup = document.querySelector('header-component .z-30.flex')
          if (btnGroup && !document.getElementById('langSwitcher')) {
            const wrap = document.createElement('div')
            wrap.id = 'langSwitcher'
            wrap.className =
              'inline-flex items-center rounded-md border p-0.5 text-xs font-medium sm:group-[.not-top]:rounded-xl'
            wrap.innerHTML = `
              <button type="button" data-set-lang="zh" class="lang-btn px-1.5 py-1 rounded transition-colors">中</button>
              <button type="button" data-set-lang="ja" class="lang-btn px-1.5 py-1 rounded transition-colors">日</button>
              <button type="button" data-set-lang="en" class="lang-btn px-1.5 py-1 rounded transition-colors">EN</button>
            `
            wrap.querySelectorAll('button[data-set-lang]').forEach((b) => {
              b.addEventListener('click', () => {
                applyLang(b.getAttribute('data-set-lang'))
              })
            })
            btnGroup.insertBefore(wrap, btnGroup.firstChild)
          }
          applyLang(localStorage.getItem('site-lang') || 'zh')
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', mountLangSwitcher)
        } else {
          mountLangSwitcher()
        }
        document.addEventListener('astro:page-load', mountLangSwitcher)

        // BFCache (Back/Forward Cache) restoration: re-sync language when page restored from memory
        window.addEventListener('pageshow', () => {
          mountLangSwitcher()
        })

        // Speculation Rules prerender activation: re-sync language when prerendered page is activated
        if (document.prerendering) {
          document.addEventListener('prerenderingchange', () => {
            mountLangSwitcher()
          })
        }

        // Cross-tab synchronization
        window.addEventListener('storage', (e) => {
          if (e.key === 'site-lang' && e.newValue) {
            applyLang(e.newValue)
          }
        })
      })()
    </script>

    {/* Set highlight color & i18n visibility rules & Japanese font optimization */}
    <style define:vars={{ highlightColor }}>
      :global(html[data-lang='zh'] [data-i18n]:not([data-i18n='zh'])),
      :global(html[data-lang='ja'] [data-i18n]:not([data-i18n='ja'])),
      :global(html[data-lang='en'] [data-i18n]:not([data-i18n='en'])) {
        display: none !important;
      }

      /* 针对日文字体专门排版：优先采用 Windows/Mac 现代高解析日文字体，避免字符回退导致字形杂乱 */
      :global(html[data-lang='ja']),
      :global(html[data-lang='ja'] body),
      :global(html[lang='ja']),
      :global(html[lang='ja'] body) {
        font-family: var(--font-satoshi), -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "BIZ UDPGothic", "Yu Gothic", "YuGothic", "Meiryo", "Noto Sans JP", sans-serif !important;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      /* 中文字体排版 */
      :global(html[data-lang='zh']),
      :global(html[data-lang='zh'] body),
      :global(html[lang='zh-CN']),
      :global(html[lang='zh-CN'] body) {
        font-family: var(--font-satoshi), -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif !important;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* 英文字体排版 */
      :global(html[data-lang='en']),
      :global(html[data-lang='en'] body),
      :global(html[lang='en']),
      :global(html[lang='en'] body) {
        font-family: var(--font-satoshi), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, "PingFang SC", "Hiragino Sans", "Microsoft YaHei", "Yu Gothic" !important;
      }

      :global(#langSwitcher .lang-btn) {
        color: hsl(var(--muted-foreground));
      }
      :global(#langSwitcher .lang-btn:hover) {
        color: hsl(var(--foreground));
      }
      :global(#langSwitcher .lang-btn.lang-active) {
        background-color: hsl(var(--border));
        color: hsl(var(--foreground));
        font-weight: 600;
      }

      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: var(--highlight-fg, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      #main-container {
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }
    </style>
  </body>
</html>
