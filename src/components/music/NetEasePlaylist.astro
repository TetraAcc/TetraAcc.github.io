---
import { NETEASE_FEATURED_PLAYLIST_URL } from '@/data/music'

const neteaseCards = [
  {
    type: 'Playlist',
    tag: { zh: '2,739 首精选', ja: '2,739曲 厳選', en: '2,739 Tracks' },
    title: {
      zh: '我喜欢的音乐 · Liked Songs',
      ja: 'お気に入り音楽 · Liked Songs',
      en: 'Liked Songs'
    },
    desc: {
      zh: '“保持幻想 保持冷静 不要活的时间太长 不要无聊。”',
      ja: '「幻想を保ち、冷静さを保ち、退屈に生きるな。」',
      en: '“Stay imaginative, stay calm, and never be bored.”'
    },
    meta: {
      zh: '2,069 次收听 · 点击收听完整歌单',
      ja: '2,069回再生 · プレイリストを開く',
      en: '2,069 Listens · Open Playlist'
    },
    href: NETEASE_FEATURED_PLAYLIST_URL,
    pic: 'https://p1.music.126.net/hchaGch0kKwh-ejHRljxVw==/109951173582402399.jpg',
    badge: '163'
  },
  {
    type: 'Profile',
    tag: { zh: 'UID: 310896659', ja: 'UID: 310896659', en: 'UID: 310896659' },
    title: {
      zh: 'VirusT · 网易云主页',
      ja: 'VirusT · NetEaseプロフィール',
      en: 'VirusT · NetEase Profile'
    },
    desc: {
      zh: '个人音乐动态、完整歌单与听歌排行榜',
      ja: '音楽アクティビティ、公開プレイリスト、リスニングランキング',
      en: 'Personal music feed, public playlists & rankings'
    },
    meta: {
      zh: '网易云音乐个人空间',
      ja: 'NetEaseクラウド音楽個人ページ',
      en: 'NetEase Music Profile'
    },
    href: 'https://music.163.com/#/user/home?id=310896659',
    pic: 'https://p1.music.126.net/76MU-fyebZuk9oYDGjtiRQ==/109951163714120886.jpg',
    badge: 'User'
  }
]
---

<div class='not-prose my-4'>
  <div class='grid grid-cols-1 md:grid-cols-2 gap-3'>
    {
      neteaseCards.map((item) => (
        <a
          href={item.href}
          target='_blank'
          rel='noopener noreferrer'
          class='group relative flex flex-row items-center gap-3.5 rounded-xl border border-border/70 bg-card/40 p-2.5 transition-all duration-200 hover:border-foreground/30 hover:bg-muted/40 no-underline'
        >
          <div class='relative size-24 sm:size-28 shrink-0 overflow-hidden rounded-lg bg-muted border border-border/40'>
            <img
              src={item.pic}
              alt='NetEase Cover'
              loading='lazy'
              referrerpolicy='no-referrer'
              class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
            />
            <div class='absolute inset-0 bg-black/10 transition-opacity group-hover:opacity-0' />
            <span class='absolute bottom-1 right-1 rounded bg-black/60 px-1 py-0.5 text-[10px] font-mono leading-none text-white/90 backdrop-blur-sm'>
              {item.badge}
            </span>
          </div>

          <div class='flex min-w-0 flex-1 flex-col justify-center gap-y-1'>
            <div class='flex items-center justify-between gap-1 text-[11px] font-mono text-muted-foreground'>
              <span class='rounded bg-muted px-1.5 py-0.5 text-foreground/80 font-medium'>
                <span data-i18n='zh'>{item.tag.zh}</span>
                <span data-i18n='ja'>{item.tag.ja}</span>
                <span data-i18n='en'>{item.tag.en}</span>
              </span>
              <span class='text-[10px] text-muted-foreground/80'>{item.type}</span>
            </div>

            <div class='line-clamp-1 text-sm font-medium text-foreground transition-colors group-hover:text-primary leading-snug'>
              <span data-i18n='zh'>{item.title.zh}</span>
              <span data-i18n='ja'>{item.title.ja}</span>
              <span data-i18n='en'>{item.title.en}</span>
            </div>

            <div class='line-clamp-1 text-xs text-muted-foreground/80'>
              <span data-i18n='zh'>{item.desc.zh}</span>
              <span data-i18n='ja'>{item.desc.ja}</span>
              <span data-i18n='en'>{item.desc.en}</span>
            </div>

            <div class='flex items-center justify-between text-xs text-muted-foreground mt-0.5'>
              <span class='truncate text-[11px]'>
                <span data-i18n='zh'>{item.meta.zh}</span>
                <span data-i18n='ja'>{item.meta.ja}</span>
                <span data-i18n='en'>{item.meta.en}</span>
              </span>
              <span class='ml-1 shrink-0 text-muted-foreground/60 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary font-mono'>
                ↗
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>
